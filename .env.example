# Postgres (en Vercel lo carga la integración de Prisma Postgres)
DATABASE_URL="postgresql://bairesya:bairesya@localhost:5434/bairesya"

# Secreto para firmar las sesiones (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Usuario admin inicial (lo usa `npx prisma db seed`)
ADMIN_USERNAME="admin"
ADMIN_INITIAL_PASSWORD=""

# Vercel Blob (en Vercel lo carga la integración de Blob)
BLOB_READ_WRITE_TOKEN=""

# Número de WhatsApp de la tienda, con código de país y sin "+" (ej: 5491112345678)
# (también se acepta NEXT_PUBLIC_WHATSAPP_NUMBER)
WHATSAPP_NUMBER=""

# URL pública del sitio (SEO / sitemap). En Vercel, si falta, se usa el dominio de producción.
# (también se acepta NEXT_PUBLIC_SITE_URL)
SITE_URL="http://localhost:3000"
